---
import { proofs } from '@/data/proofs';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const dict = getDictionary(Astro.props.lang);
---

<section class="proofs" aria-labelledby="proofs-title">
  <div class="wrap">
    <h2 id="proofs-title" class="mono label">
      {dict.proofs.title}
    </h2>
    <ul>
      {proofs.map((proof, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <p class="value">
            <span data-count={proof.value}>{proof.value}</span>
            {proof.suffix && <span class="suffix">{proof.suffix}</span>}
          </p>
          <p class="what">{dict.proofs.items[proof.id].label}</p>
          <p class="mono source">{dict.proofs.items[proof.id].source}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proofs {
    border-block: 1px solid var(--color-line);
    background: color-mix(in oklch, var(--color-surface) 55%, transparent);
  }
  .label {
    padding-top: 1.25rem;
    color: var(--color-muted);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.5rem 1rem 1.75rem 0;
  }
  li:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--color-line);
  }
  li:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }
  li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .value {
    display: flex;
    align-items: baseline;
    color: var(--color-strong);
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .suffix {
    color: var(--color-accent-text);
  }
  .what {
    max-width: 14rem;
    color: var(--color-fg);
    line-height: 1.3;
  }
  .source {
    color: var(--color-muted);
    font-size: 0.6875rem;
  }
  @media (min-width: 64rem) {
    ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    li,
    li:nth-child(even),
    li:nth-child(n + 3) {
      padding: 2rem 1.5rem 2.25rem;
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
    li:first-child {
      padding-left: 0;
      border-left: 0;
    }
    li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>
