---
import Section from '@/components/Section.astro';
import { getDictionary, sectionId, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { education } = getDictionary(lang);
---

<Section id={sectionId(lang, 'education')} sectionKey="education" index="05" title={education.title}>
  <ul class="rows">
    {education.items.map((item, index) => (
      <li data-reveal style={`--reveal-delay:${index * 70}ms`}>
        <span class="mono num" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3>{item.title}</h3>
        <p>{item.detail}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .rows {
    border-top: 1px solid var(--color-line-strong);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--color-line);
  }
  li::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 600ms var(--ease-expo);
  }
  li:hover::after {
    transform: scaleX(1);
  }
  .num {
    color: var(--color-accent-text);
  }
  h3 {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  p {
    grid-column: 2;
    color: var(--color-muted);
  }
  @media (min-width: 64rem) {
    li {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
    }
    .num {
      grid-column: 1;
    }
    h3 {
      grid-column: 2 / span 6;
    }
    p {
      grid-column: 9 / -1;
    }
  }
</style>
