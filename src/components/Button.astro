---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'ghost';
  icon?: 'arrow' | 'down' | 'none';
  magnetic?: boolean;
} & (HTMLAttributes<'a'> | HTMLAttributes<'button'>);

const { variant = 'ghost', icon = 'none', magnetic = false, class: className, ...rest } = Astro.props;
const Element = 'href' in rest ? 'a' : 'button';
const attrs = Element === 'button' ? { type: 'button' as const, ...rest } : rest;
---

<Element
  class:list={['btn', `btn-${variant}`, className]}
  data-magnetic={magnetic ? '' : undefined}
  {...(attrs as Record<string, unknown>)}
>
  <slot />
  {icon === 'arrow' && (
    <svg class="icon icon-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M4 12 12 4M5.5 4H12v6.5"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )}
  {icon === 'down' && (
    <svg class="icon icon-down" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M8 2.5v8m0 0L4.5 7M8 10.5 11.5 7M3 13.5h10"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )}
</Element>
